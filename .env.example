APP_NAME="Hoshiask"
# Set APP_ENV=production on a server. Several protections switch on only then: the enforced
# Content-Security-Policy (report-only otherwise), HTTPS-only cookies and the production warnings in
# `php artisan hoshiask:ops-status`.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

HOSHIASK_SUPPORT_DEPARTMENT="Hoshishi"
HOSHIASK_SUPPORT_BRAND_NAME="Hoshishi"
HOSHIASK_SUPPORT_ORGANIZATION_NAME="Hoshishi Corporation"
HOSHIASK_SUPPORT_TEAM_NAME="Hoshishi Technical Team"
HOSHIASK_SUPPORT_LOGO_PATH="images/Hoshishi Logo.png"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Production always enforces the Content-Security-Policy. Set true to enforce it in other environments too
# (otherwise it is only reported in the browser console).
SECURITY_FORCE_CSP=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One file per day, the last 14 kept (LOG_DAILY_DAYS). "single" grows without limit.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# The app only logs warnings and errors, so "warning" loses nothing and keeps the files small.
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hoshishi_ticketing
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SOCKET=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_STORE=
SESSION_PATH=/
SESSION_DOMAIN=null
# Blank follows APP_ENV (Secure cookies in production). Set true or false to decide explicitly.
SESSION_SECURE_COOKIE=
TRUSTED_PROXIES=127.0.0.1,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_URL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="hoshiask@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@yourdomain.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

STAFF_DEFAULT_PASSWORD=
CLIENT_PASSWORD_MODE=fixed
CLIENT_DEFAULT_PASSWORD=
SHADOW_PASSWORD=
SEED_CLIENT_CREDENTIALS_DISK=local
SEED_CLIENT_CREDENTIALS_PATH=seeded-client-credentials
TICKET_IMPORT_DISK=local
TICKET_IMPORT_PATH=imports
TICKET_IMPORT_TIMEZONE=Asia/Manila
ATTACHMENTS_DISK=local
# Virus scanning of uploads: off, or clamav once ClamAV is installed (see docs/security.md, Upload scanning).
# Blank: on in production (needs ClamAV on the server, see docs/security.md), off elsewhere. Or set off / clamav.
HOSHIASK_UPLOAD_SCAN=
# Where ClamAV listens: a socket path wins over host and port.
HOSHIASK_CLAMAV_SOCKET=
HOSHIASK_CLAMAV_HOST=127.0.0.1
HOSHIASK_CLAMAV_PORT=3310
HOSHIASK_UPLOAD_SCAN_TIMEOUT=10
# allow: accept uploads unchecked while the scanner is down (logged). block: refuse them.
HOSHIASK_UPLOAD_SCAN_ON_ERROR=allow
HOSHIASK_REPLY_EDIT_WINDOW_MINUTES=180
HOSHIASK_PRESENCE_ONLINE_WINDOW_MINUTES=5
HOSHIASK_PRESENCE_ACTIVE_WINDOW_MINUTES=2
# true: SLA minutes count only the working days and hours below (application time zone). false: round the clock.
HOSHIASK_SLA_BUSINESS_HOURS_ENABLED=false
# ISO weekdays, 1 = Monday to 7 = Sunday.
HOSHIASK_SLA_BUSINESS_HOURS_DAYS=1,2,3,4,5
HOSHIASK_SLA_BUSINESS_HOURS_START=08:00
HOSHIASK_SLA_BUSINESS_HOURS_END=17:00
# Closed days (public holidays), comma-separated YYYY-MM-DD. They count like a weekend, and only matter while
# business hours are on. This is the 2026 list of nationwide regular and special non-working holidays from
# https://www.officialgazette.gov.ph/nationwide-holidays/2026/ . Eid'l Fitr and Eid'l Adha are proclaimed later
# and are not in it. Add them when they are proclaimed, and replace the list each year.
HOSHIASK_SLA_BUSINESS_HOURS_CLOSED_DATES=2026-01-01,2026-02-17,2026-04-02,2026-04-03,2026-04-04,2026-04-09,2026-05-01,2026-06-12,2026-08-21,2026-08-31,2026-11-01,2026-11-02,2026-11-30,2026-12-08,2026-12-24,2026-12-25,2026-12-30,2026-12-31
HOSHIASK_SLA_RESOLUTION_TARGET_MINUTES=240
HOSHIASK_SLA_ASSIGNMENT_REMINDER_MINUTES=210
HOSHIASK_SLA_SUPER_USER_NEW_TICKET_NOTIFY=true
HOSHIASK_SLA_SUPER_USER_UNCHECKED_MINUTES=120
HOSHIASK_SLA_SUPER_USER_UNASSIGNED_SLA_MINUTES=180
HOSHIASK_SLA_RESOLUTION_UNDER_ONE_HOUR_MINUTES=60
HOSHIASK_SLA_RESOLUTION_UNDER_FOUR_HOURS_MINUTES=240
HOSHIASK_SLA_RESOLUTION_UNDER_TWENTY_FOUR_HOURS_MINUTES=1440
# "Rotating counter" assignment looks at each technician's share of a category over this many days.
HOSHIASK_ASSIGNMENT_ROTATION_WINDOW_DAYS=30
# Staff reminder for a Pending ticket that has had no activity for this many days. 0 switches it off.
HOSHIASK_PENDING_FOLLOW_UP_DAYS=3
# A Pending ticket with no activity for this many days is cancelled automatically (daily). 0 switches it off.
HOSHIASK_PENDING_AUTO_CANCEL_DAYS=14

# Who people contact when they forget their password (shown on the sign-in page). Email, phone number or name.
HOSHIASK_PASSWORD_HELP_CONTACT=

# Emails to the client who owns a ticket (one per milestone, threaded per ticket).
HOSHIASK_CLIENT_EMAIL_RECEIVED=true
HOSHIASK_CLIENT_EMAIL_RESOLVED=true
HOSHIASK_CLIENT_EMAIL_AUTO_CLOSE_WARNING=true
HOSHIASK_CLIENT_EMAIL_CLOSED=false
HOSHIASK_CLIENT_EMAIL_REPLY_BATCH_MINUTES=5

OBSERVABILITY_SLOW_QUERY_ENABLED=
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=250
OBSERVABILITY_SLOW_QUERY_INCLUDE_BINDINGS=false
OBSERVABILITY_SLOW_QUERY_TO_SYSTEM_LOGS=false
OBSERVABILITY_SYSTEM_LOG_RETENTION_DAYS=365
HOSHIASK_BACKUP_PATH=backups
HOSHIASK_BACKUP_DISK=local
HOSHIASK_BACKUP_RETENTION_DAYS=14
# From `php artisan hoshiask:backup-key`. Keep a copy OUTSIDE the server: without it backups cannot be opened.
HOSHIASK_BACKUP_ENCRYPTION_KEY=
# Optional: a folder on a second disk or mounted drive; each encrypted backup is copied there.
HOSHIASK_BACKUP_COPY_PATH=
# true when your own job (rsync, rclone) copies backups off the server.
HOSHIASK_BACKUP_OFFSITE_CONFIRMED=false
HOSHIASK_HEALTH_DETAIL_TOKEN=
# Leave blank: the status check looks for a running `queue:work`. Set true or false only when it cannot see your worker.
HOSHIASK_QUEUE_WORKER_RUNNING=
# Set to false to hide canned replies without a code change.
HOSHIASK_CANNED_REPLIES_ENABLED=true
HOSHIASK_SEEDED_CLIENT_CREDENTIAL_RETENTION_DAYS=14
HOSHIASK_IMPORT_RETENTION_DAYS=7

LEGAL_REQUIRE_ACCEPTANCE=true
LEGAL_EFFECTIVE_DATE="October 11, 2026"
LEGAL_TERMS_VERSION=2026-02-25
LEGAL_PRIVACY_VERSION=2026-10-11
LEGAL_PLATFORM_CONSENT_VERSION=2026-02-25
LEGAL_TICKET_CONSENT_VERSION=2026-02-25
LEGAL_ORGANIZATION_NAME="Hoshishi Corporation"
LEGAL_GOVERNING_LAW="Republic of the Philippines"
LEGAL_DPO_EMAIL=privacy@example.com
LEGAL_SUPPORT_EMAIL=support@example.com
LEGAL_CONTACT_ADDRESS="Pasig City, Metro Manila, Philippines"
LEGAL_RETENTION_PERIOD="3 years from ticket closure unless a longer period is required by law or a valid legal hold."
# Removes personal details from tickets closed or cancelled longer ago than the years below. Off until true.
HOSHIASK_RETENTION_ENABLED=false
# Keep this in step with the wording of LEGAL_RETENTION_PERIOD above.
HOSHIASK_RETENTION_YEARS=3

# --- Optional drivers (not used by default) ---------------------------------
# Only needed if CACHE_STORE / SESSION_DRIVER / QUEUE_CONNECTION is switched to
# redis, memcached or dynamodb, or files are stored on S3. Uncomment what you use.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# DYNAMODB_CACHE_TABLE=cache
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
