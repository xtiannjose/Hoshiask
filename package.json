{
    "name": "hoshiask",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite dev",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "qa": "npm run lint && npm run test:unit && npm run build && npm audit --audit-level=high",
        "qa:full": "npm run qa && npm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:watch": "vitest",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@alpinejs/csp": "^3.15.11",
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@fontsource/plus-jakarta-sans": "^5.3.0",
        "@fontsource/space-grotesk": "^5.3.0",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/postcss": "^4.2.1",
        "eslint": "^10.12.0",
        "globals": "^17.13.0",
        "laravel-vite-plugin": "^3.0.1",
        "postcss": "^8.5.30",
        "tailwindcss": "^4.2.1",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
