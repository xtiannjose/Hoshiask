APP_NAME="Helpdesk"
# Set APP_ENV=production on a server. Several protections switch on only then: the login limit of 5 a minute
# (100 otherwise), the enforced Content-Security-Policy (report-only otherwise), HTTPS-only cookies and the
# production warnings in `php artisan helpdesk:ops-status`.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8000

HELPDESK_SUPPORT_DEPARTMENT="Hoshishi"
HELPDESK_SUPPORT_BRAND_NAME="Hoshishi"
HELPDESK_SUPPORT_ORGANIZATION_NAME="Hoshishi Corporation"
HELPDESK_SUPPORT_TEAM_NAME="Hoshishi Technical Team"
HELPDESK_SUPPORT_LOGO_PATH="images/Hoshishi Logo.png"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Production always enforces the Content-Security-Policy. Set true to enforce it in other environments too
# (otherwise it is only reported in the browser console).
SECURITY_FORCE_CSP=false

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# One file per day, the last 14 kept (LOG_DAILY_DAYS). "single" grows without limit.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# The app only logs warnings and errors, so "warning" loses nothing and keeps the files small.
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hoshishi_ticketing
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SOCKET=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_FOREIGN_KEYS=true
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_STORE=
SESSION_PATH=/
SESSION_DOMAIN=null
# Blank follows APP_ENV (Secure cookies in production). Set true or false to decide explicitly.
SESSION_SECURE_COOKIE=
TRUSTED_PROXIES=127.0.0.1,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_URL=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS="helpdesk@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_REPLY_TO_ADDRESS="support@yourdomain.com"
MAIL_REPLY_TO_NAME="${APP_NAME}"

STAFF_DEFAULT_PASSWORD=
CLIENT_PASSWORD_MODE=fixed
CLIENT_DEFAULT_PASSWORD=
SHADOW_PASSWORD=
SEED_CLIENT_CREDENTIALS_DISK=local
SEED_CLIENT_CREDENTIALS_PATH=seeded-client-credentials
TICKET_IMPORT_DISK=local
TICKET_IMPORT_PATH=imports
TICKET_IMPORT_TIMEZONE=Asia/Manila
ATTACHMENTS_DISK=local
# Virus scanning of uploads: off, or clamav once ClamAV is installed (see docs/security.md, Upload scanning).
# Blank: on in production (needs ClamAV on the server, see docs/security.md), off elsewhere. Or set off / clamav.
HELPDESK_UPLOAD_SCAN=
# Where ClamAV listens: a socket path wins over host and port.
HELPDESK_CLAMAV_SOCKET=
HELPDESK_CLAMAV_HOST=127.0.0.1
HELPDESK_CLAMAV_PORT=3310
HELPDESK_UPLOAD_SCAN_TIMEOUT=10
# allow: accept uploads unchecked while the scanner is down (logged). block: refuse them.
HELPDESK_UPLOAD_SCAN_ON_ERROR=allow
HELPDESK_REPLY_EDIT_WINDOW_MINUTES=180
HELPDESK_PRESENCE_ONLINE_WINDOW_MINUTES=5
HELPDESK_PRESENCE_ACTIVE_WINDOW_MINUTES=2
HELPDESK_SLA_RESOLUTION_TARGET_MINUTES=240
HELPDESK_SLA_ASSIGNMENT_REMINDER_MINUTES=210
HELPDESK_SLA_SUPER_USER_NEW_TICKET_NOTIFY=true
HELPDESK_SLA_SUPER_USER_UNCHECKED_MINUTES=120
HELPDESK_SLA_SUPER_USER_UNASSIGNED_SLA_MINUTES=180
HELPDESK_SLA_RESOLUTION_UNDER_ONE_HOUR_MINUTES=60
HELPDESK_SLA_RESOLUTION_UNDER_FOUR_HOURS_MINUTES=240
HELPDESK_SLA_RESOLUTION_UNDER_TWENTY_FOUR_HOURS_MINUTES=1440
# "Rotating counter" assignment looks at each technician's share of a category over this many days.
HELPDESK_ASSIGNMENT_ROTATION_WINDOW_DAYS=30

# Who people contact when they forget their password (shown on the sign-in page). Email, phone number or name.
HELPDESK_PASSWORD_HELP_CONTACT=

# Emails to the client who owns a ticket (one per milestone, threaded per ticket).
HELPDESK_CLIENT_EMAIL_RECEIVED=true
HELPDESK_CLIENT_EMAIL_RESOLVED=true
HELPDESK_CLIENT_EMAIL_AUTO_CLOSE_WARNING=true
HELPDESK_CLIENT_EMAIL_CLOSED=false
HELPDESK_CLIENT_EMAIL_REPLY_BATCH_MINUTES=5

OBSERVABILITY_SLOW_QUERY_ENABLED=
OBSERVABILITY_SLOW_QUERY_THRESHOLD_MS=250
OBSERVABILITY_SLOW_QUERY_INCLUDE_BINDINGS=false
OBSERVABILITY_SLOW_QUERY_TO_SYSTEM_LOGS=false
OBSERVABILITY_SYSTEM_LOG_RETENTION_DAYS=365
HELPDESK_BACKUP_PATH=backups
HELPDESK_BACKUP_DISK=local
HELPDESK_BACKUP_RETENTION_DAYS=14
# From `php artisan helpdesk:backup-key`. Keep a copy OUTSIDE the server: without it backups cannot be opened.
HELPDESK_BACKUP_ENCRYPTION_KEY=
# Optional: a folder on a second disk or mounted drive; each encrypted backup is copied there.
HELPDESK_BACKUP_COPY_PATH=
# true when your own job (rsync, rclone) copies backups off the server.
HELPDESK_BACKUP_OFFSITE_CONFIRMED=false
HELPDESK_HEALTH_DETAIL_TOKEN=
# Leave blank: the status check looks for a running `queue:work`. Set true or false only when it cannot see your worker.
HELPDESK_QUEUE_WORKER_RUNNING=
# Set to false to hide canned replies without a code change.
HELPDESK_CANNED_REPLIES_ENABLED=true
HELPDESK_SEEDED_CLIENT_CREDENTIAL_RETENTION_DAYS=14
HELPDESK_IMPORT_RETENTION_DAYS=7

LEGAL_REQUIRE_ACCEPTANCE=true
LEGAL_EFFECTIVE_DATE="February 25, 2026"
LEGAL_TERMS_VERSION=2026-02-25
LEGAL_PRIVACY_VERSION=2026-02-25
LEGAL_PLATFORM_CONSENT_VERSION=2026-02-25
LEGAL_TICKET_CONSENT_VERSION=2026-02-25
LEGAL_ORGANIZATION_NAME="Hoshishi Corporation"
LEGAL_GOVERNING_LAW="Republic of the Philippines"
LEGAL_DPO_EMAIL=privacy@example.com
LEGAL_SUPPORT_EMAIL=support@example.com
LEGAL_CONTACT_ADDRESS="Pasig City, Metro Manila, Philippines"
LEGAL_RETENTION_PERIOD="3 years from ticket closure unless a longer period is required by law or a valid legal hold."
# Removes personal details from tickets closed or cancelled longer ago than the years below. Off until true.
HELPDESK_RETENTION_ENABLED=false
# Keep this in step with the wording of LEGAL_RETENTION_PERIOD above.
HELPDESK_RETENTION_YEARS=3

# --- Optional drivers (not used by default) ---------------------------------
# Only needed if CACHE_STORE / SESSION_DRIVER / QUEUE_CONNECTION is switched to
# redis, memcached or dynamodb, or files are stored on S3. Uncomment what you use.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# DYNAMODB_CACHE_TABLE=cache
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
